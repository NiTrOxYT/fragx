# Database URL for PostgreSQL (Vercel + Supabase transaction pooler)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Direct URL for Prisma Migrations / db push (Supabase session pooler / direct port 5432)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Admin PIN for login
ADMIN_PIN="change-this-in-production"

# Session Secret Key
SESSION_SECRET="change-this-to-a-long-random-secret"
