// Prisma schema for FRAGX (PostgreSQL for Vercel + Supabase)
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PLAYER
  MODERATOR
  ADMIN
}

model Player {
  id            String        @id @default(cuid())
  name          String        @unique
  avatarUrl     String
  role          Role          @default(PLAYER)
  accessKeyHash String?
  isActive      Boolean       @default(true)
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  matches       Match[]
  matchPlayers  MatchPlayer[]

  @@index([teamId])
}

model GamingSession {
  id          String        @id @default(cuid())
  date        DateTime
  status      String        @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  matches     Match[]

  @@index([status])
  @@index([date])
}

model Team {
  id        String      @id @default(cuid())
  name      String      @unique
  avatarUrl String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  teams     MatchTeam[]
  players   Player[]

  @@index([name])
  @@index([isActive])
}



model Match {
  id            String        @id @default(cuid())
  sessionId     String
  session       GamingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  matchNumber   Int
  playerId      String?
  player        Player?       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kills         Int?
  placement     Int?
  screenshotUrl String
  duration      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  matchTeams    MatchTeam[]

  @@unique([sessionId, matchNumber])
  @@index([sessionId])
  @@index([playerId])
  @@index([matchNumber])
}

model MatchTeam {
  id        String        @id @default(cuid())
  matchId   String
  match     Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  placement Int
  players   MatchPlayer[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([matchId, teamId])
  @@unique([matchId, placement])
  @@index([matchId])
  @@index([teamId])
}

model MatchPlayer {
  id          String    @id @default(cuid())
  matchTeamId String
  matchTeam   MatchTeam @relation(fields: [matchTeamId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  kills       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([matchTeamId, playerId])
  @@index([matchTeamId])
  @@index([playerId])
}

